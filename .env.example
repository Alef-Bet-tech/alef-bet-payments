# Keepz Integration Credentials
# Get these from your Keepz representative
KEEPZ_IDENTIFIER=your-identifier-here
KEEPZ_INTEGRATOR_ID=your-integrator-uuid-here
KEEPZ_RECEIVER_ID=your-receiver-uuid-here

# RSA Keys (Base64 DER encoded, single line, no headers)
# Keepz's public key - for encrypting requests TO Keepz
KEEPZ_RSA_PUBLIC_KEY=keepz-public-key-base64
# Your private key - for decrypting responses FROM Keepz
OUR_RSA_PRIVATE_KEY=your-private-key-base64

# Environment: 'dev' or 'prod'
KEEPZ_ENV=dev

# Your website URLs (for redirects after payment)
SITE_URL=http://localhost:3000
SUCCESS_REDIRECT_URL=http://localhost:3000/success.html
FAIL_REDIRECT_URL=http://localhost:3000/fail.html

# Server
PORT=3000
